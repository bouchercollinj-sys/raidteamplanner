# Copy to `.dev.vars` for `npm run dev` (Wrangler local secrets).
# BETTER_AUTH_SECRET must be at least 32 characters.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:43127

# Google Workspace SMTP for password reset emails from reset@lastminute.technology.
# Create an App Password for that mailbox and paste it here.
SMTP_PASSWORD=
